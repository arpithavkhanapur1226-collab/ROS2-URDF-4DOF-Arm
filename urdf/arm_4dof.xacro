<?xml version="1.0"?>

<robot name="arm_4dof" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================================================== -->
  <!-- PARAMETERS -->
  <!-- ===================================================== -->

  <xacro:property name="base_radius" value="0.30"/>
  <xacro:property name="base_height" value="0.10"/>

  <xacro:property name="link1_radius" value="0.12"/>
  <xacro:property name="link1_length" value="0.60"/>

  <xacro:property name="link2_radius" value="0.10"/>
  <xacro:property name="link2_length" value="0.50"/>

  <xacro:property name="link3_radius" value="0.08"/>
  <xacro:property name="link3_length" value="0.40"/>

  <xacro:property name="link4_radius" value="0.06"/>
  <xacro:property name="link4_length" value="0.30"/>


  <!-- ===================================================== -->
  <!-- BASE -->
  <!-- ===================================================== -->

  <link name="base_link">

    <visual>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>

      <origin xyz="0 0 0.05" rpy="0 0 0"/>

      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${base_radius}" length="${base_height}"/>
      </geometry>

      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </collision>

    <!-- Approximate mass and inertia -->
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia
        ixx="0.115"
        ixy="0.0"
        ixz="0.0"
        iyy="0.115"
        iyz="0.0"
        izz="0.225"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- LINK 1 -->
  <!-- ===================================================== -->

  <link name="link1">

    <visual>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_length}"/>
      </geometry>

      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>

      <material name="orange">
        <color rgba="0.9 0.4 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${link1_radius}" length="${link1_length}"/>
      </geometry>

      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 ${link1_length/2}" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia
        ixx="0.0975"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0975"
        iyz="0.0"
        izz="0.018"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- LINK 2 -->
  <!-- ===================================================== -->

  <link name="link2">

    <visual>
      <geometry>
        <cylinder radius="${link2_radius}" length="${link2_length}"/>
      </geometry>

      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>

      <material name="yellow">
        <color rgba="0.9 0.7 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${link2_radius}" length="${link2_length}"/>
      </geometry>

      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 ${link2_length/2}" rpy="0 0 0"/>
      <mass value="2.0"/>
      <inertia
        ixx="0.0458"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0458"
        iyz="0.0"
        izz="0.010"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- LINK 3 -->
  <!-- ===================================================== -->

  <link name="link3">

    <visual>
      <geometry>
        <cylinder radius="${link3_radius}" length="${link3_length}"/>
      </geometry>

      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>

      <material name="green">
        <color rgba="0.2 0.7 0.3 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${link3_radius}" length="${link3_length}"/>
      </geometry>

      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 ${link3_length/2}" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia
        ixx="0.022"
        ixy="0.0"
        ixz="0.0"
        iyy="0.022"
        iyz="0.0"
        izz="0.0048"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- LINK 4 -->
  <!-- ===================================================== -->

  <link name="link4">

    <visual>
      <geometry>
        <cylinder radius="${link4_radius}" length="${link4_length}"/>
      </geometry>

      <origin xyz="0 0 ${link4_length/2}" rpy="0 0 0"/>

      <material name="red">
        <color rgba="0.8 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${link4_radius}" length="${link4_length}"/>
      </geometry>

      <origin xyz="0 0 ${link4_length/2}" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 ${link4_length/2}" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.0082"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0082"
        iyz="0.0"
        izz="0.0018"/>
    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- JOINT 1 -->
  <!-- ===================================================== -->

  <joint name="joint1" type="revolute">

    <parent link="base_link"/>
    <child link="link1"/>

    <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>

    <axis xyz="0 0 1"/>

    <limit
      lower="-3.14"
      upper="3.14"
      effort="10"
      velocity="1"/>

  </joint>


  <!-- ===================================================== -->
  <!-- JOINT 2 -->
  <!-- ===================================================== -->

  <joint name="joint2" type="revolute">

    <parent link="link1"/>
    <child link="link2"/>

    <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="10"
      velocity="1"/>

  </joint>


  <!-- ===================================================== -->
  <!-- JOINT 3 -->
  <!-- ===================================================== -->

  <joint name="joint3" type="revolute">

    <parent link="link2"/>
    <child link="link3"/>

    <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-1.57"
      upper="1.57"
      effort="10"
      velocity="1"/>

  </joint>


  <!-- ===================================================== -->
  <!-- JOINT 4 -->
  <!-- ===================================================== -->

  <joint name="joint4" type="revolute">

    <parent link="link3"/>
    <child link="link4"/>

    <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>

    <axis xyz="0 1 0"/>

    <limit
      lower="-3.14"
      upper="3.14"
      effort="10"
      velocity="1"/>

  </joint>


  <!-- ===================================================== -->
  <!-- WRIST -->
  <!-- ===================================================== -->

  <link name="wrist_link">

    <visual>
      <geometry>
        <cylinder radius="0.07" length="0.12"/>
      </geometry>

      <origin xyz="0 0 0.06" rpy="0 0 0"/>

      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.07" length="0.12"/>
      </geometry>

      <origin xyz="0 0 0.06" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia
        ixx="0.0008"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0008"
        iyz="0.0"
        izz="0.0012"/>
    </inertial>

  </link>


  <!-- WRIST JOINT -->

  <joint name="wrist_joint" type="fixed">

    <parent link="link4"/>
    <child link="wrist_link"/>

    <origin xyz="0 0 ${link4_length}" rpy="0 0 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- GRIPPER BASE -->
  <!-- ===================================================== -->

  <link name="gripper_base">

    <visual>
      <geometry>
        <box size="0.18 0.12 0.06"/>
      </geometry>

      <origin xyz="0 0 0.03" rpy="0 0 0"/>

      <material name="gripper_gray">
        <color rgba="0.35 0.35 0.35 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.18 0.12 0.06"/>
      </geometry>

      <origin xyz="0 0 0.03" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia
        ixx="0.0008"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0018"
        iyz="0.0"
        izz="0.0024"/>
    </inertial>

  </link>


  <!-- GRIPPER MOUNT -->

  <joint name="gripper_mount_joint" type="fixed">

    <parent link="wrist_link"/>
    <child link="gripper_base"/>

    <origin xyz="0 0 0.12" rpy="0 0 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- LEFT FINGER -->
  <!-- ===================================================== -->

  <link name="left_finger">

    <visual>
      <geometry>
        <box size="0.04 0.04 0.16"/>
      </geometry>

      <origin xyz="0 0 0.08" rpy="0 0 0"/>

      <material name="finger_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.04 0.04 0.16"/>
      </geometry>

      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00034"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00034"
        iyz="0.0"
        izz="0.000004"/>
    </inertial>

  </link>


  <!-- LEFT FINGER JOINT -->

  <joint name="left_finger_joint" type="fixed">

    <parent link="gripper_base"/>
    <child link="left_finger"/>

    <origin xyz="0.07 0 0.06" rpy="0 0 0"/>

  </joint>


  <!-- ===================================================== -->
  <!-- RIGHT FINGER -->
  <!-- ===================================================== -->

  <link name="right_finger">

    <visual>
      <geometry>
        <box size="0.04 0.04 0.16"/>
      </geometry>

      <origin xyz="0 0 0.08" rpy="0 0 0"/>

      <material name="finger_blue">
        <color rgba="0.1 0.3 0.8 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.04 0.04 0.16"/>
      </geometry>

      <origin xyz="0 0 0.08" rpy="0 0 0"/>
    </collision>

    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00034"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00034"
        iyz="0.0"
        izz="0.000004"/>
    </inertial>

  </link>


  <!-- RIGHT FINGER JOINT -->

  <joint name="right_finger_joint" type="fixed">

    <parent link="gripper_base"/>
    <child link="right_finger"/>

    <origin xyz="-0.07 0 0.06" rpy="0 0 0"/>

  </joint>


</robot>
